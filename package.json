{
  "name": "to-do-widget",
  "version": "0.1.4",
  "description": "Desktop to-do widget that turns Google Calendar events and Gmail messages into tasks",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "demo": "electron . --demo",
    "test": "node --test test/*.test.js",
    "dist:win": "electron-builder --win nsis"
  },
  "license": "MIT",
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "productName": "To-do Widget",
  "author": "Nakorn Gurdsomboon",
  "build": {
    "appId": "com.jokernk2211.todowidget",
    "productName": "To-do Widget",
    "files": [
      "src/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "shortcutName": "To-do Widget",
      "runAfterFinish": true
    }
  }
}
